# Copy to .env for local use only. Never commit the resulting .env file.
NODE_ENV=development
APP_VERSION=local
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Reserved for later migration phases. Leave blank during Phase S1; the
# application continues to use the NestJS API and existing session model.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supply a dedicated local PostgreSQL connection and credentials.
POSTGRES_USER=residence
POSTGRES_PASSWORD=
POSTGRES_DB=residence
POSTGRES_PORT=5432
DATABASE_URL=

# Generate independent random values with at least 32 characters.
SESSION_SECRET=
IDENTITY_DATA_KEY=
SESSION_COOKIE_NAME=residence_session
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
LOG_LEVEL=log
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

PRIVATE_STORAGE_ROOT=var/private
RESIDENT_FILE_MAX_BYTES=5000000
RESIDENCE_SEED_ENABLED=false
RESIDENCE_SEED_PASSWORD=

# Sandbox adapters never claim live delivery. Production must use disabled
# until a reviewed live provider is implemented and configured.
NOTIFICATION_PROVIDER_MODE=sandbox
NOTIFICATION_EMAIL_FROM=no-reply@example.invalid
NOTIFICATION_SMS_SENDER=Residence
NOTIFICATION_CALLBACK_SECRET=
PAYMENT_PROVIDER_MODE=disabled
PAYMENT_SANDBOX_SECRET=

# --- Phase S2: Supabase Auth ------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/icffsyxlrgmwdjaazoue/settings/api
# Project URL (same for all environments)
NEXT_PUBLIC_SUPABASE_URL=https://icffsyxlrgmwdjaazoue.supabase.co
# Anon / Publishable key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service Role key (server-only, NEVER commit or expose to browser)
SUPABASE_URL=https://icffsyxlrgmwdjaazoue.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret � from: Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=
# Feature flag � set true ONLY after running supabase-auth-import.ts and verifying
FEATURE_SUPABASE_AUTH=false
# Feature flag � set true ONLY after running create-storage-buckets.ts
FEATURE_SUPABASE_STORAGE=false

# Feature flag � set true to use Supabase Edge Functions for notification delivery
FEATURE_SUPABASE_NOTIFY=false
# Resend API key for Edge Function email delivery (optional, leave blank for sandbox mode)
RESEND_API_KEY=
