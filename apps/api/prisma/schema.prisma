model Society {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String        @unique @db.VarChar(80)
  name       String        @db.VarChar(160)
  timeZone   String        @default("Asia/Karachi") @map("time_zone") @db.VarChar(80)
  currency   String        @default("PKR") @db.Char(3)
  status     SocietyStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(6)
  version    Int           @default(0)

  users                   UserAccount[]
  roles                   Role[]
  userRoles               UserRole[]
  sessions                UserSession[]
  settings                SystemSetting[]
  audits                  AuditLog[]
  residents               Resident[]
  vehicles                Vehicle[]
  properties              Property[]
  residentSequences       ResidentIDSequence[]
  feePlans                FeePlan[]
  billingPeriods          BillingPeriod[]
  monthlyDues             MonthlyDue[]
  payments                Payment[]
  ledgerEntries           FinancialLedgerEntry[]
  financialBatches        FinancialBatch[]
  receiptSequences        ReceiptSequence[]
  departments             Department[]
  jobTitles               JobTitle[]
  staffMembers            StaffMember[]
  salaryPeriods           SalaryPeriod[]
  staffSequences          StaffIDSequence[]
  workerCategories        WorkerCategory[]
  workerSkills            WorkerSkill[]
  serviceWorkers          ServiceWorker[]
  contractorCompanies     ContractorCompany[]
  workerSequences         WorkerIDSequence[]
  salarySlipSequences     SalarySlipSequence[]
  complaintCategories     ComplaintCategory[]
  maintenanceCategories   MaintenanceCategory[]
  complaints              Complaint[]
  maintenanceRequests     MaintenanceRequest[]
  ticketSequences         TicketSequence[]
  serviceLevelPolicies    ServiceLevelPolicy[]
  notificationTemplates   NotificationTemplate[]
  notificationBatches     NotificationBatch[]
  notifications           Notification[]
  announcements           Announcement[]
  notificationPreferences NotificationPreference[]
  financialSettings       FinancialSettingPeriod[]
  profileCorrections      ProfileCorrectionRequest[]
  visitorPasses           VisitorPass[]
  visitorCheckIns         VisitorCheckIn[]

  @@index([status])
  @@map("society")
}

model UserAccount {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId           String        @map("society_id") @db.Uuid
  username            String        @db.VarChar(100)
  normalizedUsername  String        @unique @map("normalized_username") @db.VarChar(100)
  email               String?       @db.VarChar(254)
  normalizedEmail     String?       @unique @map("normalized_email") @db.VarChar(254)
  displayName         String        @map("display_name") @db.VarChar(160)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  status              AccountStatus @default(INVITED)
  forcePasswordChange Boolean       @default(true) @map("force_password_change")
  emailVerified       Boolean       @default(false) @map("email_verified")
  failedLoginCount    Int           @default(0) @map("failed_login_count")
  lockedUntil         DateTime?     @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?     @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?     @map("password_changed_at") @db.Timestamptz(6)
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  version             Int           @default(0)

  // Phase S2 — Supabase Auth link
  authUserId         String?            @unique @map("auth_user_id") @db.Uuid
  authMigrationState AuthMigrationState @default(PENDING) @map("auth_migration_state")
  authMigratedAt     DateTime?          @map("auth_migrated_at") @db.Timestamptz(6)

  society                    Society                    @relation(fields: [societyId], references: [id], onDelete: Restrict)
  roles                      UserRole[]
  sessions                   UserSession[]
  resetTokens                PasswordResetToken[]
  audits                     AuditLog[]
  resident                   Resident?
  staffProfile               StaffMember?               @relation("StaffUser")
  workerProfile              ServiceWorker?             @relation("WorkerUser")
  createdFeePlans            FeePlan[]                  @relation("FeePlanCreator")
  assignedFees               ResidentFeeAssignment[]    @relation("FeeAssignmentActor")
  financialBatches           FinancialBatch[]           @relation("FinancialBatchActor")
  recordedPayments           Payment[]                  @relation("PaymentActor")
  paymentAdjustments         PaymentAdjustment[]        @relation("AdjustmentActor")
  discountsOrWaivers         DiscountOrWaiver[]         @relation("DiscountActor")
  paymentReversals           PaymentReversal[]          @relation("ReversalActor")
  refunds                    Refund[]                   @relation("RefundActor")
  issuedReceipts             Receipt[]                  @relation("ReceiptIssuer")
  notificationRecipients     NotificationRecipient[]
  notificationPreference     NotificationPreference?
  profileCorrectionRequests  ProfileCorrectionRequest[] @relation("ProfileCorrectionRequester")
  resolvedProfileCorrections ProfileCorrectionRequest[] @relation("ProfileCorrectionResolver")
  createdFinancialSettings   FinancialSettingPeriod[]   @relation("FinancialSettingCreator")
  guardCheckIns              VisitorCheckIn[]           @relation("GuardCheckIns")

  @@index([societyId, status])
  @@map("user_account")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  code        String   @db.VarChar(80)
  displayName String   @map("display_name") @db.VarChar(120)
  description String?  @db.VarChar(300)
  systemRole  Boolean  @default(false) @map("system_role")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(0)

  society     Society          @relation(fields: [societyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([societyId, code], name: "uk_role_society_code")
  @@index([societyId, active])
  @@map("role")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(120)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(0)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  societyId  String   @map("society_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  society Society     @relation(fields: [societyId], references: [id], onDelete: Restrict)
  user    UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([societyId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId     String    @map("society_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(200)
  sourceIp      String?   @map("source_ip") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  society Society     @relation(fields: [societyId], references: [id], onDelete: Restrict)
  user    UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([societyId, expiresAt])
  @@map("user_session")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_token")
}

model SystemSetting {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId       String?   @map("society_id") @db.Uuid
  settingKey      String    @map("setting_key") @db.VarChar(160)
  valueType       String    @map("value_type") @db.VarChar(30)
  settingValue    String?   @map("setting_value")
  secretReference String?   @map("secret_reference") @db.VarChar(255)
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int       @default(0)

  society Society? @relation(fields: [societyId], references: [id], onDelete: Restrict)

  @@index([societyId, settingKey, archivedAt])
  @@map("system_setting")
}

model AuditLog {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId     String?      @map("society_id") @db.Uuid
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  action        String       @db.VarChar(120)
  targetType    String?      @map("target_type") @db.VarChar(100)
  targetId      String?      @map("target_id") @db.VarChar(100)
  outcome       AuditOutcome
  reason        String?      @db.VarChar(500)
  correlationId String?      @map("correlation_id") @db.VarChar(100)
  safeMetadata  Json         @default("{}") @map("safe_metadata")
  sourceIp      String?      @map("source_ip") @db.VarChar(64)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  society Society?     @relation(fields: [societyId], references: [id], onDelete: Restrict)
  actor   UserAccount? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([societyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model OutboxEvent {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType    String       @map("aggregate_type") @db.VarChar(100)
  aggregateId      String       @map("aggregate_id") @db.VarChar(100)
  eventType        String       @map("event_type") @db.VarChar(160)
  payload          Json
  deduplicationKey String       @unique @map("deduplication_key") @db.VarChar(180)
  status           OutboxStatus @default(PENDING)
  availableAt      DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(6)
  failedAttempts   Int          @default(0) @map("failed_attempts")
  lastError        String?      @map("last_error") @db.VarChar(1000)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_event")
}

model Property {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId            String       @map("society_id") @db.Uuid
  block                String       @db.VarChar(80)
  street               String?      @db.VarChar(160)
  propertyNumber       String       @map("property_number") @db.VarChar(80)
  normalizedAddressKey String       @map("normalized_address_key") @db.VarChar(320)
  type                 PropertyType
  active               Boolean      @default(true)
  archivedAt           DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int          @default(0)

  society             Society              @relation(fields: [societyId], references: [id], onDelete: Restrict)
  units               Unit[]
  complaints          Complaint[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([societyId, normalizedAddressKey], name: "uk_property_society_address")
  @@index([societyId, block, active])
  @@map("property")
}

model Unit {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId           String     @map("property_id") @db.Uuid
  unitNumber           String     @map("unit_number") @db.VarChar(80)
  normalizedUnitNumber String     @map("normalized_unit_number") @db.VarChar(80)
  status               UnitStatus @default(AVAILABLE)
  parkingInformation   String?    @map("parking_information") @db.VarChar(300)
  archivedAt           DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int        @default(0)

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  occupancies         ResidentOccupancy[]
  feePlans            FeePlan[]
  complaints          Complaint[]
  maintenanceRequests MaintenanceRequest[]
  visitorPasses       VisitorPass[]

  @@unique([propertyId, normalizedUnitNumber], name: "uk_unit_property_number")
  @@index([propertyId, status])
  @@map("unit")
}

model Resident {
  id                         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  societyId                  String         @map("society_id") @db.Uuid
  userId                     String?        @unique @map("user_id") @db.Uuid
  residentNumber             String         @map("resident_number") @db.VarChar(80)
  fullName                   String         @map("full_name") @db.VarChar(160)
  normalizedFullName         String         @map("normalized_full_name") @db.VarChar(160)
  guardianName               String?        @map("guardian_name") @db.VarChar(160)
  dateOfBirth                DateTime?      @map("date_of_birth") @db.Date
  gender                     Gender         @default(UNDISCLOSED)
  email                      String?        @db.VarChar(254)
  primaryPhone               String         @map("primary_phone") @db.VarChar(30)
  alternatePhone             String?        @map("alternate_phone") @db.VarChar(30)
  identityCiphertext         String?        @map("identity_ciphertext") @db.Text
  identitySearchHash         String?        @map("identity_search_hash") @db.Char(64)
  identityLastFour           String?        @map("identity_last_four") @db.VarChar(4)
  permanentAddress           String?        @map("permanent_address") @db.VarChar(500)
  emergencyContactName       String?        @map("emergency_contact_name") @db.VarChar(160)
  emergencyContactPhone      String?        @map("emergency_contact_phone") @db.VarChar(30)
  profilePhotographObjectKey String?        @map("profile_photograph_object_key") @db.VarChar(500)
  householdSize              Int            @default(1) @map("household_size")
  status                     ResidentStatus @default(ACTIVE)
  suspensionReason           String?        @map("suspension_reason") @db.VarChar(500)
  archivedAt                 DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
